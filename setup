#!/usr/bin/env bash
# One-time setup: bind one or more git repos to this agents control plane.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
CFG_DIR="$ROOT/.eng"
CFG="$CFG_DIR/config.json"
REPOS=()
DRIVER="issue"

usage() {
  cat <<EOF
Usage:
  ./setup --repo /path/to/git-project [--repo /path/to/another] [--driver issue|schedule|both]

What it does:
  1) Checks codex is installed
  2) Saves bound repos to .eng/config.json (gitignored)
  3) Ensures ./eng is executable

Examples:
  ./setup --repo ~/code/my-app
  ./setup --repo ~/code/api --repo ~/code/web --driver both
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPOS+=("$2"); shift 2 ;;
    --driver) DRIVER="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; usage; exit 1 ;;
  esac
done

if [[ ${#REPOS[@]} -eq 0 ]]; then
  usage
  exit 1
fi

if ! command -v codex >/dev/null 2>&1; then
  echo "codex not found in PATH. Install Codex CLI and login first." >&2
  exit 1
fi

ABS_REPOS=()
for r in "${REPOS[@]}"; do
  if [[ ! -d "$r" ]]; then
    echo "Not a directory: $r" >&2
    exit 1
  fi
  abs="$(cd "$r" && pwd)"
  if [[ ! -d "$abs/.git" ]]; then
    echo "Warning: $abs has no .git (still binding)" >&2
  fi
  ABS_REPOS+=("$abs")
done

mkdir -p "$CFG_DIR"
# migrate old .cea config if present
if [[ -f "$ROOT/.cea/config.json" && ! -f "$CFG" ]]; then
  cp "$ROOT/.cea/config.json" "$CFG"
fi

python3 - "$CFG" "$DRIVER" "${ABS_REPOS[@]}" <<'PY'
import json, sys, pathlib
path = pathlib.Path(sys.argv[1])
driver = sys.argv[2]
repos = sys.argv[3:]
data = {
  "version": 1,
  "driver": driver,
  "repos": [{"path": p, "enabled": True} for p in repos],
}
path.write_text(json.dumps(data, indent=2) + "\n")
print(f"wrote {path}")
for p in repos:
    print(f"  - {p}")
PY

chmod +x "$ROOT/setup" "$ROOT/eng"

cat <<EOF

Setup OK.

Next:
  ./eng
  # Trust this project when Codex asks
  # Then: Spawn coding to … / Spawn security to …

Issue one-shot:
  ./eng issue "Implement issue #123 in the bound repo; do not merge"

Schedule:
  ./eng print-cron

Config: $CFG
EOF
