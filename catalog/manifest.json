{
  "$schema": "./manifest.schema.json",
  "apiVersion": "eng-agents.patsnap.com/v1",
  "catalogVersion": "1.0.1",
  "compatibility": {
    "plugin": ">=1.0.0 <2.0.0"
  },
  "agents": [
    {
      "id": "coding",
      "path": "agents/coding.toml",
      "owner": "engineering-productivity",
      "skillDependencies": [],
      "integrationDependencies": []
    },
    {
      "id": "security",
      "path": "agents/security.toml",
      "owner": "engineering-productivity",
      "skillDependencies": [],
      "integrationDependencies": []
    }
  ],
  "skills": [
    {
      "id": "issue-pipeline",
      "path": "agents/skills/issue-pipeline",
      "owner": "engineering-productivity",
      "kind": "dispatcher",
      "agentDependencies": ["coding", "security"],
      "skillDependencies": [],
      "integrationDependencies": []
    },
    {
      "id": "security-review",
      "path": "agents/skills/security-review",
      "owner": "engineering-productivity",
      "kind": "dispatcher",
      "agentDependencies": ["security"],
      "skillDependencies": [],
      "integrationDependencies": []
    },
    {
      "id": "scheduled-issue-poll",
      "path": "agents/skills/scheduled-issue-poll",
      "owner": "engineering-productivity",
      "kind": "dispatcher",
      "agentDependencies": [],
      "skillDependencies": ["issue-pipeline"],
      "integrationDependencies": ["company-gitlab"]
    }
  ],
  "integrations": [
    {
      "id": "company-gitlab",
      "path": "integrations/cli/company-gitlab/integration.json",
      "owner": "engineering-productivity",
      "kind": "cli"
    }
  ],
  "entrypoints": {
    "scheduledIssuePoll": {
      "skill": "scheduled-issue-poll"
    }
  }
}
